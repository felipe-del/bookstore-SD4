# Cadena de conexión de PostgreSQL (Neon / Supabase / local)
DATABASE_URL=postgres://usuario:clave@host/basedatos?sslmode=require
# Ponga false solo si usa un Postgres local sin SSL
DB_SSL=true
# URL AMQP de su instancia de CloudAMQP (panel "Details" -> AMQP URL)
CLOUDAMQP_URL=amqps://usuario:clave@host/vhost
# Nombres de las colas
QUEUE_BOOKS=bookstore
QUEUE_AUTHORS=authors
QUEUE_PUBLISHERS=publishers
